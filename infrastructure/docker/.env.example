[TEMPLATE]
# ─── SatQuery AI — Environment Configuration ────────────────────────────────
# P6-01: Copy this to .env and edit as needed
# cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=satquery
POSTGRES_USER=satquery
POSTGRES_PASSWORD=satquery_dev
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO (S3-compatible) ─────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── API Gateway ──────────────────────────────────────────────────────────────
API_PORT=8000
MISSION_PORT=8001
AGENT_PORT=8002
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_S=60

# ── Frontend ─────────────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=/api/v1

# ── TiTiler ──────────────────────────────────────────────────────────────────
TITILER_PORT=8081
TITILER_API_KEY=

# ── Observability ────────────────────────────────────────────────────────────
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
