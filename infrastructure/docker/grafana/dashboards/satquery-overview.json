{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"satquery-api\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "title": "API Latency (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_server_requests_seconds_bucket{job=\"satquery-api\"}[5m]))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"satquery-api\"}[5m]))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job=\"satquery-api\"}[5m]))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "title": "API Error Rate (5xx)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"satquery-api\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"satquery-api\"}[5m])) * 100",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } },
        "overrides": []
      }
    },
    {
      "title": "Agent Node Durations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "agent_node_duration_ms",
          "legendFormat": "{{node_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      }
    },
    {
      "title": "Agent Tool Calls",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "agent_tool_calls_total",
          "legendFormat": "{{tool_name}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "title": "Celery Worker Active Tasks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "celery_active_tasks",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Celery Task Success Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(celery_task_succeeded_total[5m])) / (sum(rate(celery_task_succeeded_total[5m])) + sum(rate(celery_task_failed_total[5m]))) * 100",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 95 }] } },
        "overrides": []
      }
    },
    {
      "title": "Confidence Gate Pass/Fail",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 8, "y": 20 },
      "targets": [
        {
          "expr": "confidence_gate_total",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Prompt Injection Blocks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 14, "y": 20 },
      "targets": [
        {
          "expr": "prompt_injection_block_total",
          "legendFormat": "Blocks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] } },
        "overrides": []
      }
    },
    {
      "title": "PostgreSQL Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 18, "y": 20 },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "Active connections",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["satquery", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "SatQuery API Overview",
  "uid": "satquery-overview",
  "version": 1
}
