# Benchmark imagery -- downloaded, never committed.
# Sen1Floods11 chips are ~1 MB each and are reproducible from
# fetch_sen1floods11.py, so the repo stores the fetcher, not the data.
data/sen1floods11/
*.tif
*.tiff

# Model checkpoints and metrics -- generated by ml/scripts/train_unet.py,
# reproducible from the committed script and the committed split.
artifacts/

# reports/ is NOT ignored. It is generated too, but it is the one place any
# number quoted about the ML subsystem is allowed to come from, and CI checks it
# against a fingerprint of the code that produced it (P3-15). A generated file
# that must be committed is unusual; the alternative is numbers living only in
# prose, which is the failure this exists to prevent.
