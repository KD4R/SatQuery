[importlinter]
root_package = satquery

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers = apps
         services
         packages

[importlinter:contract:module-independence]
name = Service modules do not import each other directly
type = independence
modules = services.planner
          services.discovery
          services.analysis
          services.evidence
          services.decision
          services.monitoring
          services.reporting
