# Gateway base URL. The browser may call this origin and nothing else.
NEXT_PUBLIC_GATEWAY_URL=/api/v1

# Deterministic demo mode (P5-17). When 1, every panel is fed from
# lib/fixtures/ and carries a visible DEMO FIXTURE badge; the telemetry bar
# reads ENV: DEMO. Fixtures are never used as a fallback for a failed live call.
NEXT_PUBLIC_DEMO_MODE=0
