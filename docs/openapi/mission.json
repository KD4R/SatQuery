          "geometry": {
            "additionalProperties": true,
            "type": "object",
            "title": "Geometry"
          },
          "organisation_id": {
            "type": "string",
            "title": "Organisation Id"
          },
          "created_by": {
            "type": "string",
            "title": "Created By"
