{
  "openapi": "3.1.0",
  "info": {
    "title": "SatQuery Agent Service",
    "description": "AI Agent & LangGraph Orchestrator for SatQuery AI",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/agent/plan": {
      "post": {
        "tags": [
          "agent-plan"
        ],
        "summary": "Create Plan",
        "operationId": "create_plan_api_v1_agent_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/agent/execute": {
      "post": {
        "tags": [
          "agent-execute"
        ],
        "summary": "Execute Agent",
        "operationId": "execute_agent_api_v1_agent_execute_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecuteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecuteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/agent/runs/{job_id}": {
      "get": {
        "tags": [
          "agent-execute"
        ],
        "summary": "Get Run Status",
        "operationId": "get_run_status_api_v1_agent_runs__job_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/sensor-decision": {
      "post": {
        "tags": [
          "agent-sensor-decision"
        ],
        "summary": "Sensor Decision",
        "operationId": "sensor_decision_api_v1_agent_sensor_decision_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensorDecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SensorDecisionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/agent/confidence": {
      "post": {
        "tags": [
          "agent-confidence"
        ],
        "summary": "Evaluate Confidence",
        "operationId": "evaluate_confidence_api_v1_agent_confidence_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfidenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfidenceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/agent/tools": {
      "get": {
        "tags": [
          "agent-tools"
        ],
        "summary": "List Tools",
        "operationId": "list_tools_api_v1_agent_tools_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response List Tools Api V1 Agent Tools Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfidenceRequest": {
        "properties": {
          "evidence_nodes": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Evidence Nodes"
          },
          "sensor_type": {
            "type": "string",
            "title": "Sensor Type",
            "default": "SAR"
          },
          "cloud_cover": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Cloud Cover",
            "default": 0.0
          },
          "resolution_meters": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Resolution Meters",
            "default": 10.0
          }
        },
        "type": "object",
        "title": "ConfidenceRequest"
      },
      "ConfidenceResponse": {
        "properties": {
          "confidence_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Score"
          },
          "passed_gate": {
            "type": "boolean",
            "title": "Passed Gate"
          },
          "uncertainty_factors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Uncertainty Factors"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "confidence_score",
          "passed_gate",
          "action"
        ],
        "title": "ConfidenceResponse"
      },
      "ExecuteRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "Mission prompt"
          },
          "mission_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mission Id",
            "description": "Mission ID"
          },
          "aoi": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aoi",
            "description": "GeoJSON polygon or bbox"
          },
          "temporal_window": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temporal Window",
            "description": "Time window"
          },
          "budget": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget",
            "description": "Tool execution budget constraints"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ExecuteRequest"
      },
      "ExecuteResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "mission_id": {
            "type": "string",
            "title": "Mission Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "mission_id",
          "status",
          "message"
        ],
        "title": "ExecuteResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthStatus"
      },
      "MissionState": {
        "properties": {
          "mission_id": {
            "type": "string",
            "title": "Mission Id",
            "description": "Unique mission identifier"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id",
            "description": "Execution run identifier"
          },
          "organization_id": {
            "type": "string",
            "title": "Organization Id",
            "description": "Tenant organization identifier"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id",
            "description": "Background job identifier"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id",
            "description": "Distributed trace identifier"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "Raw natural language prompt"
          },
          "sanitized_query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sanitized Query",
            "description": "Sanitized query text"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Workflow state: INITIALIZED, PLANNING, ACQUIRING, ANALYZING, GATE_CHECK, COMPLETED, FAILED, CLARIFICATION_REQUIRED",
            "default": "INITIALIZED"
          },
          "intent": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent",
            "description": "Extracted mission intent"
          },
          "aoi": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aoi",
            "description": "GeoJSON Area of Interest"
          },
          "temporal_window": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temporal Window",
            "description": "Temporal comparison window (baseline vs current)"
          },
          "selected_sensors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Selected Sensors",
            "description": "List of chosen satellite sensors (e.g. S1_SAR, S2_OPTICAL)"
          },
          "observation_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Observation Ids",
            "description": "IDs of selected satellite observations"
          },
          "tool_calls": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Tool Calls",
            "description": "Audit trail of tool calls executed"
          },
          "evidence_graph": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Graph",
            "description": "Structured DAG of evidence nodes and edges"
          },
          "confidence_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Score",
            "description": "Overall confidence score [0.0 - 1.0]",
            "default": 0.0
          },
          "uncertainty_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Uncertainty Reasons",
            "description": "Explicit reasons for low confidence or uncertainty"
          },
          "synthesized_output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Synthesized Output",
            "description": "Evidence-backed synthesis and explanations"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors",
            "description": "Encountered errors/warnings"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "System provenance metadata: dataset_id, model_version, processing_version"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Last update timestamp"
          }
        },
        "type": "object",
        "required": [
          "mission_id",
          "run_id",
          "organization_id",
          "query"
        ],
        "title": "MissionState",
        "description": "Canonical MissionState model representing LangGraph / agent state across the workflow."
      },
      "PlanRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "Natural language mission objective"
          },
          "mission_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mission Id",
            "description": "Optional associated mission ID"
          },
          "aoi": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aoi",
            "description": "Optional GeoJSON AOI geometry"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Contextual metadata"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "PlanRequest"
      },
      "PlanResponse": {
        "properties": {
          "mission_id": {
            "type": "string",
            "title": "Mission Id"
          },
          "intent": {
            "additionalProperties": true,
            "type": "object",
            "title": "Intent"
          },
          "plan_steps": {
            "items": {
              "$ref": "#/components/schemas/PlanStep"
            },
            "type": "array",
            "title": "Plan Steps"
          },
          "selected_sensors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Selected Sensors"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "mission_id",
          "intent",
          "plan_steps",
          "selected_sensors"
        ],
        "title": "PlanResponse"
      },
      "PlanStep": {
        "properties": {
          "step_id": {
            "type": "string",
            "title": "Step Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          }
        },
        "type": "object",
        "required": [
          "step_id",
          "name",
          "description"
        ],
        "title": "PlanStep"
      },
      "SensorDecisionRequest": {
        "properties": {
          "hazard_type": {
            "type": "string",
            "title": "Hazard Type",
            "description": "Hazard type: flood, fire, cyclone, landslide",
            "default": "flood"
          },
          "cloud_cover_percentage": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Cloud Cover Percentage",
            "description": "Cloud cover percentage",
            "default": 0.0
          },
          "is_night": {
            "type": "boolean",
            "title": "Is Night",
            "description": "Whether observation is at night",
            "default": false
          },
          "priority": {
            "type": "string",
            "title": "Priority",
            "description": "Optimization priority: accuracy, latency, balanced",
            "default": "balanced"
          }
        },
        "type": "object",
        "title": "SensorDecisionRequest"
      },
      "SensorDecisionResponse": {
        "properties": {
          "primary_sensor": {
            "type": "string",
            "title": "Primary Sensor"
          },
          "secondary_sensor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Secondary Sensor"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          },
          "arbitration_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Arbitration Score"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "primary_sensor",
          "rationale",
          "arbitration_score"
        ],
        "title": "SensorDecisionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}