  "components": {
    "schemas": {
      "ConfidenceRequest": {
        "properties": {
          "evidence_nodes": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Evidence Nodes"
          },
          "sensor_type": {
            "type": "string",
            "title": "Sensor Type",
            "default": "SAR"
          },
          "cloud_cover": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Cloud Cover",
            "default": 0.0
          },
          "resolution_meters": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Resolution Meters",
            "default": 10.0
          }
        },
        "type": "object",
        "title": "ConfidenceRequest"
      },
      "ConfidenceResponse": {
        "properties": {
          "confidence_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Score"
          },
          "passed_gate": {
            "type": "boolean",
            "title": "Passed Gate"
          },
          "uncertainty_factors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Uncertainty Factors"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "confidence_score",
          "passed_gate",
          "action"
        ],
        "title": "ConfidenceResponse"
      },
      "ExecuteRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "Mission prompt"
          },
          "mission_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mission Id",
            "description": "Mission ID"
          },
          "aoi": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aoi",
            "description": "GeoJSON polygon or bbox"
          },
          "temporal_window": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temporal Window",
            "description": "Time window"
          },
          "budget": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget",
            "description": "Tool execution budget constraints"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ExecuteRequest"
      },
      "ExecuteResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "mission_id": {
            "type": "string",
            "title": "Mission Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "mission_id",
          "status",
          "message"
        ],
        "title": "ExecuteResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthStatus"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "JobStatus"
      },
      "JobStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "mission_id": {
            "type": "string",
            "title": "Mission Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "mission_id",
          "status",
          "submitted_at",
          "started_at",
          "completed_at",
          "error_message",
          "trace_id"
        ],
        "title": "JobStatusResponse"
      },
      "JobSubmitResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "mission_id": {
            "type": "string",
            "title": "Mission Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Job submitted. Poll /api/v1/jobs/{job_id} for status."
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "mission_id",
          "status",
          "submitted_at",
